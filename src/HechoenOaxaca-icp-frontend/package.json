{
  "name": "hechoenoaxaca-icp-frontend",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --skipLibCheck && vite build",
    "preview": "vite preview",
    "prebuild": "dfx generate HechoenOaxaca-icp-backend-v2 && sed -i 's|@icp-sdk/core/agent|@dfinity/agent|g' ../declarations/HechoenOaxaca-icp-backend-v2/index.js && sed -i '/createActor();/d' ../declarations/HechoenOaxaca-icp-backend-v2/index.js"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "@types/react": "^18.3.20",
