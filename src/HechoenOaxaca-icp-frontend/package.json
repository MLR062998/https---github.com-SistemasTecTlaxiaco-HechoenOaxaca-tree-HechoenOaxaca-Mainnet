    "autoprefixer": "10.4.16",
    "dotenv": "^16.4.7",
    "postcss": "8.4.35",
    "sass": "^1.87.0",
    "tailwindcss": "3.4.1",
    "terser": "^5.43.1",
    "typescript": "5.3.3",
    "vite-plugin-environment": "^1.1.3",
    "vite-plugin-top-level-await": "^1.6.0"
  },
  "dependencies": {
    "@dfinity/agent": "^2.4.1",
    "@dfinity/auth-client": "^2.4.1",
    "@dfinity/candid": "^2.4.1",
    "@dfinity/identity": "^2.4.1",
    "bootstrap": "^5.3.3",
    "buffer": "^6.0.3",
    "qrcode.react": "^4.2.0",
    "react-bootstrap": "^2.10.0",
    "react-icons": "^4.11.0",
