<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Retiro de ICP</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
</head>
<body class="bg-light">
  <div class="container mt-5">
    <div class="card shadow-sm">
      <div class="card-header bg-primary text-white">
        💸 Retirar ICP (Artesano)
      </div>
      <div class="card-body">
        <div class="mb-3">
          <label for="inputDestino" class="form-label">Account Identifier destino</label>
          <input type="text" class="form-control" id="inputDestino" placeholder="Ej: 2ed...abc">
        </div>
        <div class="mb-3">
          <label for="inputMonto" class="form-label">Monto ICP</label>
          <input type="number" class="form-control" id="inputMonto" placeholder="Ej: 0.05" step="0.0001">
        </div>
        <button class="btn btn-success w-100" id="btnRetirar">Transferir ahora</button>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script type="module" src="/js/retirar.js"></script>
</body>
</html>
