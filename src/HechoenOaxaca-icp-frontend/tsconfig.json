{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node", "react"],
    "baseUrl": ".",
    "paths": {
      "@connect2ic/core": ["./node_modules/@connect2ic/core"],
      "@connect2ic/react": ["./node_modules/@connect2ic/react"],
      "@dfinity/agent": ["./node_modules/@dfinity/agent"],
      "@dfinity/auth-client": ["./node_modules/@dfinity/auth-client"],
      "@dfinity/identity": ["./node_modules/@dfinity/identity"],
      "declarations/*": ["../declarations/*"],
      "src/*": ["./src/*"]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ]
  },
  "include": [
    "src",
    "../declarations",
    "./node_modules/@connect2ic/core",
    "./node_modules/@connect2ic/react",
    "./node_modules/@dfinity/agent",
    "./node_modules/@dfinity/auth-client",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
