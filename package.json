{
  "name": "hechoen-oaxaca-icp",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "scripts": {
    "validate": "./validate-declarations.sh",
    "deploy:ic": "npm run validate && dfx deploy --network ic",
    "prebuild": "node scripts/patch-rollup-ast.cjs && dfx generate HechoenOaxaca-icp-backend-v2 && ./fix-broken-dts.sh && ./fix-did-imports.sh && ./fix-did-envs.sh && ./sanitize-declarations.sh",
    "pretest": "npm run prebuild --workspaces --if-present",
    "start": "npm start --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "dev": "npm run dev --workspace=src/HechoenOaxaca-icp-frontend",
    "build": "npm run prebuild && npm run build:frontend && npm run postbuild",
    "build:frontend": "npm run build --workspace=src/HechoenOaxaca-icp-frontend",
    "postbuild": "./scripts/postbuild-merged.sh",
    "postinstall": "node scripts/patch-rollup-ast.cjs"
  },
  "workspaces": [
    "src/HechoenOaxaca-icp-frontend"
  ],
  "dependencies": {
    "@connect2ic/core": "^0.2.0-beta.24",
    "@connect2ic/react": "^0.2.0-beta.24",
    "@dfinity/agent": "^2.4.1",
    "@dfinity/auth-client": "^2.4.1",
    "@dfinity/candid": "^2.4.1",
    "@dfinity/identity": "^2.4.1",
    "@dfinity/principal": "^2.4.1",
    "qrcode.react": "^4.2.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.3",
    "@types/node": "^20.17.47",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "process": "^0.11.10",
    "rollup": "^2.79.1",
    "sass": "^1.88.0",
    "vite": "^4.4.9",
    "vite-plugin-node-polyfills": "^0.23.0"
  }
}
