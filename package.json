{
  "name": "hechoen-oaxaca-icp",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "scripts": {
    "prebuild": "node scripts/patch-rollup-ast.cjs && dfx generate && ./fix-did-imports.sh",
    "pretest": "npm run prebuild --workspaces --if-present",
