    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.25",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.7",
    "rollup": "2.70.1",
    "vite": "^2.9.16"
  },
  "overrides": {
    "rollup": "2.70.1"
  }
}
